#!/bin/bash
#PBS -S /bin/bash
#PBS -j oe
#PBS -W group_list=s1055
#PBS -q devel
#PBS -l select=1:ncpus=28:model=bro_ele
#PBS -l walltime=00:30:00
# exps1: LN + LG + OG track file for 2016; check: LN + LG only must equal the current OSSE track exactly.
set -euo pipefail
PY=/nobackup/ksuselj1/envs/gchp_4dvar/bin/python3
$PY -I /nobackupp27/ksuselj1/gchp_14.8.0_adj/4dvar_osse/exps1/scripts/make_track_lnlgog.py --out /nobackupp27/ksuselj1/gchp_14.8.0_adj/4dvar_osse/exps1/obs_c24/track_file_lnlgog_2016.nc --subdirs LN,LG,OG
$PY -I /nobackupp27/ksuselj1/gchp_14.8.0_adj/4dvar_osse/exps1/scripts/make_track_lnlgog.py --out /tmp/track_lnlg_check.nc --subdirs LG,LN
$PY -I - <<PYEOF
import numpy as np, netCDF4 as nc
a = nc.Dataset("/tmp/track_lnlg_check.nc"); b = nc.Dataset("/nobackupp27/ksuselj1/gchp_14.8.0_adj/4dvar_osse/control_files_148_ckpt_min_monthly_ocean_adjm/forward/track_file_osse_2016.nc")
for k in ("time", "latitude", "longitude"):
    x, y = np.asarray(a[k][:]), np.asarray(b[k][:])
    print(k, x.shape, y.shape, "identical" if x.shape == y.shape and np.array_equal(x, y) else "DIFFERENT, max diff %s" % (np.abs(x - y).max() if x.shape == y.shape else "n/a"))
PYEOF
