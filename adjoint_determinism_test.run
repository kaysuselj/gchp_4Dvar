#!/bin/bash
#PBS -S /bin/bash
#PBS -N adj_determinism
#PBS -l select=1:ncpus=24:mpiprocs=24:model=bro_ele
#PBS -l walltime=4:00:00
#PBS -q normal
#PBS -j oe
#PBS -W group_list=s1055
#PBS -m bea
#PBS -M kay.suselj@jpl.nasa.gov

# Adjoint determinism test — investigates the noisy/spiking gradient
# (MONTHLY_SIGMA_STATUS.md outstanding item (b); iter-13 |g|inf spike of
# 7.8e3 and near-zero iteration-to-iteration gradient correlation in the
# finished one-month production run).
#
# The one-month adjoint dir is still fully primed for iteration 14 of the
# finished production run (checkpoints from the iter-14 forward, iter-14
# forcing, gcchem_initial_restart.nc4).  This job runs THAT adjoint twice
# with byte-identical inputs and compares SurfaceFluxAdj_CO2 at t_start:
#
#   identical  -> adjoint is deterministic; the gradient noise must come from
#                 its extreme sensitivity to the small iteration-to-iteration
#                 input changes (chaotic amplification, likely in convection
#                 over the Maritime Continent hotspots)
#   different  -> the adjoint is NONdeterministic (MPI reduction order,
#                 uninitialized memory, ...) — a code bug to hunt
#
# Uses ONLY 4dvar_design_osse/adjoint (one-month tree; production finished).
# Do not run while a one-month optimizer job is active.

set -euo pipefail
cd "$PBS_O_WORKDIR"
die() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

BASE_DIR="$(pwd)"                        # gchp_4Dvar/
ADJ_DIR="$(cd "${BASE_DIR}/../4dvar_design_osse/adjoint" && pwd)"
OUT_DIR="${BASE_DIR}/adj_determinism_out"
mkdir -p "${OUT_DIR}"

GCHP_ENV="${ADJ_DIR}/gchp.env"
[ -f "${GCHP_ENV}" ] || GCHP_ENV="$(cd "${ADJ_DIR}/../forward_run" && pwd)/gchp.env"
set +e; source "${GCHP_ENV}"; set -e
command -v mpiexec &>/dev/null || die "mpiexec not found"

PYTHON_ENV="${PYTHON_ENV:-/nobackup/ksuselj1/envs/gchp_4dvar}"
source "${PYTHON_ENV}/bin/activate"

NCORES=$(awk -F'[[:space:]:]+' '/^NX[[:space:]:]/ {nx=$2} /^NY[[:space:]:]/ {ny=$2} \
         END {print nx*ny}' "${ADJ_DIR}/GCHP.rc")
log "Adjoint dir: ${ADJ_DIR}  (${NCORES} cores)"

# Sanity: the primed inputs must be present
[ -f "${ADJ_DIR}/gcchem_initial_restart.nc4" ] || die "gcchem_initial_restart.nc4 missing — adjoint dir not primed"
ls "${ADJ_DIR}"/gcadj_internal_checkpoint.*_0000z.nc4 >/dev/null 2>&1 || die "no gcadj checkpoints — adjoint dir not primed"

for run in 1 2; do
    log "=== Adjoint run ${run}/2 started"
    cd "${ADJ_DIR}"
    [ -d OutputDir ] && rm -f OutputDir/GEOSChem*
    rm -f Restarts/gcchem_internal_checkpoint* cap_restart
    ./runConfig_adjoint.sh > gchp_det${run}.log 2>&1 || die "runConfig_adjoint.sh failed (run ${run})"
    mpiexec -n "${NCORES}" ./gchp >> gchp_det${run}.log 2>&1 \
        || die "Adjoint GCHP failed (run ${run}). See ${ADJ_DIR}/gchp_det${run}.log"
    log "=== Adjoint run ${run}/2 done — archiving gradient records"
    python3 - "$run" "${ADJ_DIR}/OutputDir" "${OUT_DIR}" <<'PYEOF'
import sys, glob
import numpy as np, xarray as xr
run, outdir, dest = sys.argv[1], sys.argv[2], sys.argv[3]
files = sorted(glob.glob(f'{outdir}/GEOSChem.Adjoint.*.nc4'))
ds = xr.concat([xr.open_dataset(f) for f in files], dim='time').sortby('time')
# keep t_start record + a few mid-sweep records for localization
sel = ds['SurfaceFluxAdj_CO2'].isel(time=[0, 96, 480, 960, 1440]) \
      if ds.sizes['time'] > 1440 else ds['SurfaceFluxAdj_CO2']
sel.to_netcdf(f'{dest}/adj_run{run}_records.nc4')
a0 = ds['SurfaceFluxAdj_CO2'].isel(time=0).values
print(f'run {run}: {ds.sizes["time"]} records, t0={ds.time.values[0]}, '
      f'|A(t_start)|max={np.abs(a0).max():.6e}  rms={np.sqrt((a0**2).mean()):.6e}')
PYEOF
done

log "=== Comparing the two runs"
python3 - "${OUT_DIR}" <<'PYEOF'
import sys
import numpy as np, xarray as xr
dest = sys.argv[1]
a = xr.open_dataset(f'{dest}/adj_run1_records.nc4')['SurfaceFluxAdj_CO2']
b = xr.open_dataset(f'{dest}/adj_run2_records.nc4')['SurfaceFluxAdj_CO2']
report = [f'Adjoint determinism test — {a.sizes["time"]} records compared']
identical = True
for k in range(a.sizes['time']):
    x, y = a.isel(time=k).values, b.isel(time=k).values
    d = np.abs(x - y).max()
    scale = max(np.abs(x).max(), 1e-30)
    report.append(f'  t={str(a.time.values[k])[:19]}: max|diff|={d:.6e} '
                  f'(rel {d/scale:.2e})  |A|max={np.abs(x).max():.4e}')
    if d != 0.0:
        identical = False
report.append('')
report.append('VERDICT: DETERMINISTIC (bitwise identical) — gradient noise is '
              'chaotic amplification of input changes' if identical else
              'VERDICT: NONDETERMINISTIC — adjoint output differs between '
              'identical runs; suspect MPI reduction order / uninitialized memory')
txt = '\n'.join(report)
print(txt)
open(f'{dest}/determinism_report.txt', 'w').write(txt + '\n')
PYEOF
log "Report: ${OUT_DIR}/determinism_report.txt"
