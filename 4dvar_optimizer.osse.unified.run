#!/bin/bash
#PBS -S /bin/bash
#PBS -N gchp_4dvar_osse
#PBS -l select=2:ncpus=24:mpiprocs=24:model=bro_ele
#PBS -l walltime=24:00:00
#PBS -q long
#PBS -j oe
#PBS -W group_list=s1055
#PBS -m bea
#PBS -M kay.suselj@jpl.nasa.gov

# ============================================================================
# 4D-Var outer loop for GCHP CO2 surface flux optimization — OSSE, UNIFIED.
#
# Single driver for BOTH control-variable layouts (selected with MODE):
#
#   MODE=annual  (default) — ONE sigma field over the window
#                            (write_sigma.py + lbfgsb_step.py,
#                             control_files/{forward,adjoint}_osse,
#                             work tree ../4dvar_design_osse)
#   MODE=monthly           — ONE sigma field PER MONTH of the window
#                            (write_sigma_monthly.py + lbfgsb_step_monthly.py,
#                             control_files/{forward,adjoint}_osse_monthly,
#                             work tree ../4dvar_design_osse_monthly)
#
# Everything else (env, control sync, runConfig timing, forward GCHP, J/forcing,
# checkpoint move, adjoint GCHP, plots, restart) is shared.
#
# EXECUTION MODEL — phase checkpointing + job chaining (from the monthly runner)
# is ALWAYS active but is a no-op for short windows: each iteration is split into
# phases (start / forward_done / forcing_done / adjoint_done); the last completed
# phase is written to PROGRESS_FILE; before each GCHP phase the remaining walltime
# budget is checked and, if a phase will not fit, the job resubmits itself with
# RESTART=true and resumes at that phase.  A 1-month annual iteration (~3 h) simply
# never triggers a resubmit; a 12-month monthly iteration (~36 h) chains ~2 jobs.
#
# GRID — control-variable grid (annual mode):
#   GRID=cs      (default) sigma on the native model cubed sphere (C{IM_WORLD},
#                C24 now), read with no regrid; adjoint gradient on the same grid.
#   GRID=latlon  sigma on a 72x46 lat-lon grid, regridded to CS by MAPL (legacy).
#   (Monthly mode is lat-lon only for now; GRID=cs,MODE=monthly is rejected.)
#
# EXP_NAME — run isolation for PARALLEL runs. When set, the whole work tree is a
#   private clone at ../<base>_<EXP_NAME>/ (run dirs cloned from the canonical
#   ../<base>/, and OCO2_FORCING_DIR + sigma/forcing/state/logs all private), so
#   several 4D-Vars can run at once without interfering. Empty = in-place (legacy).
#
# Submit from gchp_4Dvar/:
#   qsub 4dvar_optimizer.osse.unified.run                       # annual (GRID=cs), fresh
#   qsub -v GRID=latlon 4dvar_optimizer.osse.unified.run        # annual on lat-lon
#   qsub -v MODE=monthly,T_END=2016-04-01 4dvar_optimizer.osse.unified.run  # monthly, fresh (3-month Jan-Mar)
#   qsub -v EXP_NAME=expA 4dvar_optimizer.osse.unified.run      # isolated parallel run
#   qsub -l select=2:ncpus=24:mpiprocs=24:model=bro_ele -v NODES=2 4dvar_optimizer.osse.unified.run  # 48 cores (2 nodes)
#   qsub -v RESTART=true,MODE=monthly,T_END=2016-04-01[,EXP_NAME=expA] 4dvar_optimizer.osse.unified.run
#   qsub -v MODE=annual,MAX_ITER=10,SIGMA_B=0.3 4dvar_optimizer.osse.unified.run
#   qsub -v OBS_TYPE=satellite 4dvar_optimizer.osse.unified.run     # OCO-2 track + per-sounding AK (default)
#   qsub -v OBS_TYPE=6hourly 4dvar_optimizer.osse.unified.run       # full C24 grid every 6 h + mean AK
#   # short annual run needs less walltime:
#   qsub -l walltime=8:00:00 -v WALLTIME_S=28800 4dvar_optimizer.osse.unified.run
# If you change the #PBS walltime, pass the matching WALLTIME_S (seconds).
# RESTART=true resumes an EXP_NAME run from its private work tree.
# MODE=monthly has NO T_END default: T_END is required (month boundary, day 1)
# on fresh launch AND manual restart, so a multi-month window is never accidental.
#
# Logs: the optimizer log is written under  <work tree>/logs/ .
# ============================================================================

set -euo pipefail
cd "$PBS_O_WORKDIR"

# ============================================================
#  Helpers
# ============================================================
die() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

# assert_gchp_ok <gchp.log> <label>
# GCHP/MPT can abort mid-run yet return exit status 0 (e.g. "MPT ERROR: ...
# aborting with error code 0"), so a bare `mpiexec ... || die` does NOT catch
# a crash. This scans the log for unambiguous fatal-error signatures and dies
# if any are present, turning a silent failure into a hard stop before the
# optimizer moves incomplete checkpoints downstream.
assert_gchp_ok() {
    local logf="$1" label="$2"
    [ -f "${logf}" ] || die "${label}: ${logf} not found (GCHP produced no log)"
    local hit
    hit=$(grep -m1 -E \
        'MPT ERROR|FAIL at line=|terminated without calling MPI_Finalize|MPI_ABORT was invoked|aborting with error code|Abnormal termination|forrtl: severe|SIGSEGV|SIGBUS' \
        "${logf}" || true)
    [ -n "${hit}" ] && die "${label}: GCHP aborted despite exit 0 — matched '${hit}' in ${logf}"
    return 0
}

# ============================================================
#  Mode
# ============================================================
MODE=${MODE:-annual}
case "${MODE}" in
    annual|monthly) ;;
    *) die "MODE must be 'annual' or 'monthly' (got '${MODE}')" ;;
esac

# ============================================================
#  Configuration
# ============================================================
BASE_DIR="$(pwd)"
# SCRIPT_DIR: where Python scripts (co2_adjoint_forcing_osse.py etc.) live.
# Defaults to BASE_DIR (running from gchp_4Dvar/).
# Override when this script is copied to an experiment dir outside gchp_4Dvar/.
SCRIPT_DIR="${SCRIPT_DIR:-${BASE_DIR}}"
SELF="${SELF:-${BASE_DIR}/4dvar_optimizer.osse.unified.run}"
PARENT_DIR="$(cd "${BASE_DIR}/.." && pwd)"

# EXP_NAME isolates a run: with a name set, the whole work tree is a private
# clone (../<base>_<EXP_NAME>) so multiple 4D-Vars can run in parallel without
# clobbering each other's run dirs, sigma, forcing, state or logs. Empty (default)
# runs in-place in the canonical work tree, exactly as before.
EXP_NAME=${EXP_NAME:-}

# Control-variable grid. Default: native cubed sphere for annual (removes the
# lat-lon<->CS regrid mismatch in the gradient), lat-lon for monthly (CS not yet
# wired for the monthly control vector).
if [ "${MODE}" = "monthly" ]; then
    GRID=${GRID:-latlon}
    BASE_WORK_NAME="4dvar_design_osse_monthly"
    _CTRL_FWD_DEFAULT="${BASE_DIR}/control_files/forward_osse_monthly"
    _CTRL_ADJ_DEFAULT="${BASE_DIR}/control_files/adjoint_osse_monthly"
    STATE_BASENAME="4dvar_state_osse_monthly.npz"
    LOG_NAME="4dvar_optimizer_osse_monthly"
    T_END_DEFAULT=""
else
    GRID=${GRID:-cs}
    BASE_WORK_NAME="4dvar_design_osse"
    _CTRL_FWD_DEFAULT="${BASE_DIR}/control_files/forward_osse"
    _CTRL_ADJ_DEFAULT="${BASE_DIR}/control_files/adjoint_osse"
    STATE_BASENAME="4dvar_state_osse.npz"
    LOG_NAME="4dvar_optimizer_osse"
    T_END_DEFAULT="2016-04-01"
fi
# ============================================================
#  Observation type  (top-level switch; drives all obs-related defaults)
#
#   OBS_TYPE=satellite  (default) — OCO-2 orbital track + per-sounding AK
#       SAT_TRACK_FILE : track_file_osse_2016.nc
#       OBS_MODE       : real  (ORCHIDEE-ECCO2 per-sounding AK via semi-obs file)
#       SEMI_OBS_FILE  : <osse_4dvar>/obs/semi_obs_xco2_2016Q1.nc
#
#   OBS_TYPE=6hourly    — full C24 grid every 6 h + fixed mean AK
#       SAT_TRACK_FILE : track_file_c24_6h_3months.nc
#       OBS_MODE       : simplified  (mean AK embedded in semi-obs file)
#       SEMI_OBS_FILE  : <osse_4dvar>/obs/semi_obs_xco2_6h_simplified_2016Q1.nc
#       SIMPLIFIED_AK_FILE : same file (AK is embedded)
#
# All derived variables remain individually overridable via -v.
# ============================================================
OBS_TYPE=${OBS_TYPE:-satellite}
case "${OBS_TYPE}" in
    satellite|6hourly|24hourly) ;;
    *) die "OBS_TYPE must be 'satellite', '6hourly', or '24hourly' (got '${OBS_TYPE}')" ;;
esac

# Locate the osse_4dvar semi-obs / control tree.
# Running from inside an osse_4dvar experiment: PARENT_DIR is osse_4dvar/ itself.
# Running from gchp_4Dvar/: osse_4dvar is a sibling at PARENT_DIR/osse_4dvar/.
_OSSE4DVAR_DIR="${OSSE_ROOT:-${PARENT_DIR}/osse_4dvar}"    # OSSE_ROOT: set by the setup script
[ -d "${_OSSE4DVAR_DIR}" ] || _OSSE4DVAR_DIR="${PARENT_DIR}"

if [ "${OBS_TYPE}" = "satellite" ]; then
    _OBS_SAT_TRACK="track_file_osse_2016.nc"
    _OBS_MODE="real"
    _OBS_SEMI_OBS="${_OSSE4DVAR_DIR}/obs/semi_obs_xco2_2016Q1.nc"
    _OBS_SIMPL_AK=""
    _OBS_CTRL_FWD="${_OSSE4DVAR_DIR}/control_files/forward"
elif [ "${OBS_TYPE}" = "6hourly" ]; then
    _OBS_SAT_TRACK="track_file_c24_6h_3months.nc"
    _OBS_MODE="simplified"
    _OBS_SEMI_OBS="${_OSSE4DVAR_DIR}/obs/semi_obs_xco2_6h_simplified_2016Q1.nc"
    _OBS_SIMPL_AK="${_OBS_SEMI_OBS}"
    _OBS_CTRL_FWD="${_OSSE4DVAR_DIR}/control_files/forward"
else  # 24hourly
    _OBS_SAT_TRACK="track_file_c24_24h_3months.nc"
    _OBS_MODE="simplified"
    _OBS_SEMI_OBS="${_OSSE4DVAR_DIR}/obs/semi_obs_xco2_24h_simplified_2016Q1.nc"
    _OBS_SIMPL_AK="${_OBS_SEMI_OBS}"
    _OBS_CTRL_FWD="${_OSSE4DVAR_DIR}/control_files/forward"
fi

# 6hourly/24hourly track files span Q1 (Jan–Mar); override the 1-month default.
# Only applies in annual mode — monthly mode requires explicit T_END anyway.
if [ "${MODE}" = "annual" ] && \
   { [ "${OBS_TYPE}" = "6hourly" ] || [ "${OBS_TYPE}" = "24hourly" ]; }; then
    T_END_DEFAULT="2016-04-01"
fi

# Satellite track file (patched into HISTORY.rc + sat_track.rcx after control-files rsync)
SAT_TRACK_FILE="${SAT_TRACK_FILE:-${_OBS_SAT_TRACK}}"

# Control file dirs: user override > OBS_TYPE path > MODE-based default
CTRL_FWD_DIR="${CTRL_FWD_DIR:-${_OBS_CTRL_FWD:-${_CTRL_FWD_DEFAULT}}}"
CTRL_ADJ_DIR="${CTRL_ADJ_DIR:-${_CTRL_ADJ_DEFAULT}}"

# WORK_DIR override: set to experiment dir when using experiment-as-work-tree layout
# (osse_4dvar experiments).  Leave unset to use the default gchp_4Dvar derivation.
_WORK_DIR_OVERRIDE="${WORK_DIR:-}"
case "${GRID}" in latlon|cs) ;; *) die "GRID must be 'latlon' or 'cs' (got '${GRID}')" ;; esac
[ "${MODE}" = "monthly" ] && [ "${GRID}" = "cs" ] && \
    die "GRID=cs is not yet implemented for MODE=monthly (annual only)"

# Canonical work tree = clone source; per-EXP work tree = private copy.
SRC_WORK="${PARENT_DIR}/${BASE_WORK_NAME}"
if [ -n "${_WORK_DIR_OVERRIDE}" ]; then
    WORK_DIR="${_WORK_DIR_OVERRIDE}"
    SRC_WORK="${WORK_DIR}"   # no cloning needed; experiment dir IS the work tree
elif [ -n "${EXP_NAME}" ]; then
    WORK_DIR="${PARENT_DIR}/${BASE_WORK_NAME}_${EXP_NAME}"
else
    WORK_DIR="${SRC_WORK}"
fi

FWD_DIR="${WORK_DIR}/forward_run"
ADJ_DIR="${WORK_DIR}/adjoint"
FORCING_DIR="${WORK_DIR}/forcing_files_osse"   # patched into GCHP.rc (OCO2_FORCING_DIR)
OUTPUT_DIR="${WORK_DIR}/4dvar_output_osse"
LOG_DIR="${WORK_DIR}/logs"                     # all optimizer logs go here
LOG_FILE="${LOG_DIR}/${LOG_NAME}.log"
STATE_FILE="${WORK_DIR}/${STATE_BASENAME}"
SIGMA_FILE="${WORK_DIR}/sigma_co2_osse.nc4"    # annual: single sigma field
SIGMA_DIR="${WORK_DIR}/sigma_monthly"          # monthly: one file per month
PROGRESS_FILE="${WORK_DIR}/4dvar_progress_${MODE}.txt"
CONVERGED_FILE="${WORK_DIR}/CONVERGED_${MODE}"

RUN_STAMP="$(date +%Y%m%d_%H%M%S)"
PLOT_DIR="${WORK_DIR}/plots_osse/${RUN_STAMP}"
mkdir -p "${LOG_DIR}" "${PLOT_DIR}"

# Tee all stdout+stderr to LOG_FILE (append so chained/restarted jobs keep history)
exec > >(tee -a "${LOG_FILE}") 2>&1

# ============================================================
#  Simulation window  (both ends must be month boundaries: day 1, 00:00)
# ============================================================
T_START=${T_START:-2016-01-01}
T_END=${T_END:-${T_END_DEFAULT}}
# Monthly mode has no T_END default: require it explicitly so a multi-month
# window is a deliberate choice, never a silent full-year default.  T_END must
# carry through restarts too (it patches runConfig every run and rides in
# VPASS on self-resubmission), so this fires on fresh launch and restart alike.
[ "${MODE}" = "monthly" ] && [ -z "${T_END}" ] && \
    die "MODE=monthly requires an explicit T_END (month boundary, day 1). e.g. T_END=2016-04-01 for a 3-month Jan-Mar window; T_END=2017-01-01 for a full year."
TS_CHEM=1800
TS_DYN=1800

# Months spanned by the window; drives the monthly control vector and the
# walltime-budget estimates. 10# forces base-10 (leading-zero months not octal).
_SY=$(date -d "${T_START}" +%Y); _SM=$(date -d "${T_START}" +%m)
_EY=$(date -d "${T_END}"   +%Y); _EM=$(date -d "${T_END}"   +%m)
NMON=$(( (10#${_EY} * 12 + 10#${_EM}) - (10#${_SY} * 12 + 10#${_SM}) ))
START_MONTH=$(( 10#${_SM} ))
[ "${NMON}" -ge 1 ] || die "T_START..T_END spans ${NMON} months (need >= 1)"

# ============================================================
#  Optimization
# ============================================================
NLAT=${NLAT:-46}
NLON=${NLON:-72}
# Default lowered 0.5 -> 0.2 on 2026-07-13 (background term was ~0.5% of J, its
# gradient 30-200x weaker than g_obs at hotspots; 1/sigma_b^2 -> 6.25x stronger).
# Do not change across a RESTART (J would jump discontinuously mid-optimization).
SIGMA_B=${SIGMA_B:-0.2}
SIGMA_MIN=${SIGMA_MIN:-0.0}              # lower bound for sigma (physical: >= 0)
SIGMA_MAX=${SIGMA_MAX:-3.0}              # upper bound for sigma (sanity cap)
MAX_ITER=${MAX_ITER:-20}                 # GLOBAL iteration cap across all chained jobs
GTOL=${GTOL:-1e-5}
FTOL=${FTOL:-1e-8}
SAVE_DIAG=${SAVE_DIAG:-true}
RESTART=${RESTART:-false}

# ============================================================
#  Observation mode  (derived from OBS_TYPE; all individually overridable)
# ============================================================
# OBS_MODE=real (default for OBS_TYPE=satellite):
#   Uses ORCHIDEE-ECCO2 per-sounding AK.  SEMI_OBS_FILE must contain pre-computed
#   truth xCO2 (from make_semi_obs_xco2.py with per-sounding AK applied).
# OBS_MODE=simplified (default for OBS_TYPE=6hourly):
#   Uses a fixed mean AK embedded in SEMI_OBS_FILE (make_semi_obs_xco2_simplified.py).
#   Both SEMI_OBS_FILE and SIMPLIFIED_AK_FILE are required (may be the same file).
OBS_MODE="${OBS_MODE:-${_OBS_MODE}}"
SEMI_OBS_FILE="${SEMI_OBS_FILE:-${_OBS_SEMI_OBS}}"
SIMPLIFIED_AK_FILE="${SIMPLIFIED_AK_FILE:-${_OBS_SIMPL_AK}}"

case "${OBS_MODE}" in
    real|simplified) ;;
    *) die "OBS_MODE must be 'real' or 'simplified' (got '${OBS_MODE}')" ;;
esac
if [ "${OBS_MODE}" = "simplified" ]; then
    [ -n "${SIMPLIFIED_AK_FILE}" ] || die "OBS_MODE=simplified requires SIMPLIFIED_AK_FILE"
    [ -f "${SIMPLIFIED_AK_FILE}" ] || die "SIMPLIFIED_AK_FILE not found: ${SIMPLIFIED_AK_FILE}"
    [ -n "${SEMI_OBS_FILE}" ]      || die "OBS_MODE=simplified requires SEMI_OBS_FILE"
    [ -f "${SEMI_OBS_FILE}" ]      || die "SEMI_OBS_FILE not found: ${SEMI_OBS_FILE}"
fi
[ "${OBS_MODE}" = "real" ] && [ -n "${SEMI_OBS_FILE}" ] && \
    { [ -f "${SEMI_OBS_FILE}" ] || die "SEMI_OBS_FILE not found: ${SEMI_OBS_FILE}"; }

# Parallelism knob: one PBS node = 24 MPI ranks, so total cores = NODES * 24,
# mapped to a cubed-sphere layout by NXNY_AUTO in runConfig. Default 1 node
# (24 cores) = the historic behavior. NODES>1 also needs a matching PBS
# allocation on the initial submit (the self-resubmit sets it automatically):
#   qsub -l select=${NODES}:ncpus=24:mpiprocs=24:model=bro_ele -v NODES=${NODES},...
NODES=${NODES:-2}

# ============================================================
#  Job chaining / walltime budget
# ============================================================
CHAIN=${CHAIN:-true}                     # resubmit self when walltime is spent
CHAIN_N=${CHAIN_N:-0}                    # chained-job counter (safety)
MAX_CHAIN=${MAX_CHAIN:-60}
WALLTIME_S=${WALLTIME_S:-86400}          # must match the #PBS walltime
WALLTIME_MARGIN_S=${WALLTIME_MARGIN_S:-1800}
# Per-simulated-month cost estimates; the whole forward/adjoint estimate scales
# with the window so both annual (1 month) and monthly (12 months) are correct.
# Measured on the C24 3-month monthly run (3months_osse, 2026-08-05): forward
# ~18 min/mo, adjoint ~12 min/mo. Defaults set above measured + margin for slow
# nodes. The old 6000 (1.7 h/mo) over-budgeted a 12-month iteration past 24 h and
# forced constant self-resubmit; override via -v for an unusually slow platform.
EST_MONTH_FWD_S=${EST_MONTH_FWD_S:-1800} # ~30 min/mo forward budget (measured ~18)
EST_MONTH_ADJ_S=${EST_MONTH_ADJ_S:-1200} # ~20 min/mo adjoint budget (measured ~12)
EST_FORWARD_S=${EST_FORWARD_S:-$(( NMON * EST_MONTH_FWD_S ))}
EST_ADJOINT_S=${EST_ADJOINT_S:-$(( NMON * EST_MONTH_ADJ_S ))}

VPASS="MODE=${MODE},MAX_ITER=${MAX_ITER},SIGMA_B=${SIGMA_B},SIGMA_MIN=${SIGMA_MIN},SIGMA_MAX=${SIGMA_MAX},GTOL=${GTOL},FTOL=${FTOL}"
VPASS="${VPASS},T_START=${T_START},T_END=${T_END}"
VPASS="${VPASS},SAVE_DIAG=${SAVE_DIAG},NLAT=${NLAT},NLON=${NLON},CHAIN=${CHAIN}"
VPASS="${VPASS},MAX_CHAIN=${MAX_CHAIN},WALLTIME_S=${WALLTIME_S},WALLTIME_MARGIN_S=${WALLTIME_MARGIN_S}"
VPASS="${VPASS},EST_MONTH_FWD_S=${EST_MONTH_FWD_S},EST_MONTH_ADJ_S=${EST_MONTH_ADJ_S}"
VPASS="${VPASS},GRID=${GRID},EXP_NAME=${EXP_NAME},NODES=${NODES}"
VPASS="${VPASS},SAT_TRACK_FILE=${SAT_TRACK_FILE}"
VPASS="${VPASS},OBS_TYPE=${OBS_TYPE},OBS_MODE=${OBS_MODE}"
[ -n "${SEMI_OBS_FILE}" ]       && VPASS="${VPASS},SEMI_OBS_FILE=${SEMI_OBS_FILE}"
[ -n "${SIMPLIFIED_AK_FILE}" ]  && VPASS="${VPASS},SIMPLIFIED_AK_FILE=${SIMPLIFIED_AK_FILE}"
[ -n "${CTRL_FWD_DIR}" ]        && VPASS="${VPASS},CTRL_FWD_DIR=${CTRL_FWD_DIR}"
[ -n "${CTRL_ADJ_DIR}" ]        && VPASS="${VPASS},CTRL_ADJ_DIR=${CTRL_ADJ_DIR}"
[ -n "${_WORK_DIR_OVERRIDE}" ]  && VPASS="${VPASS},WORK_DIR=${_WORK_DIR_OVERRIDE}"
[ -n "${SCRIPT_DIR}" ] && [ "${SCRIPT_DIR}" != "${BASE_DIR}" ] && \
    VPASS="${VPASS},SCRIPT_DIR=${SCRIPT_DIR}"

# Queue job name: derive from EXP_NAME so runs are distinguishable in qstat
# (e.g. EXP_NAME=1year_osse -> "gchp_1year_osse").  Falls back to the historic
# default when EXP_NAME is unset.  Chained resubmissions below pass this with
# -N so the whole chain keeps the same name.
JOB_NAME=${JOB_NAME:-gchp_${EXP_NAME:-4dvar_osse}}

save_progress() {
    echo "iter=${CUR_ITER} phase=${CUR_PHASE}" > "${PROGRESS_FILE}"
}

resubmit() {
    log "Walltime budget spent (elapsed ${SECONDS}s of ${WALLTIME_S}s) at iter ${CUR_ITER} phase ${CUR_PHASE}"
    if [ "${CHAIN}" != "true" ]; then
        log "CHAIN=false — not resubmitting. Resume: qsub -v RESTART=true,${VPASS} ${SELF}"
        exit 0
    fi
    if [ "${CHAIN_N}" -ge "${MAX_CHAIN}" ]; then
        die "MAX_CHAIN=${MAX_CHAIN} chained jobs reached — refusing to resubmit (raise MAX_CHAIN if intended)"
    fi
    log "Resubmitting self (chain job $((CHAIN_N + 1)))"
    qsub -N "${JOB_NAME}" -l "select=${NODES}:ncpus=24:mpiprocs=24:model=bro_ele" \
        -v "RESTART=true,CHAIN_N=$((CHAIN_N + 1)),${VPASS}" "${SELF}" \
        || die "qsub resubmission failed — resume manually with RESTART=true"
    exit 0
}

# True if 'need' seconds still fit in this job's walltime budget
budget_ok() {
    local need=$1
    local remain=$(( WALLTIME_S - SECONDS - WALLTIME_MARGIN_S ))
    [ "${remain}" -ge "${need}" ]
}

# ============================================================
#  Per-experiment work tree (EXP_NAME): clone the run dirs so parallel runs
#  never share forward_run/adjoint. Cloned on a fresh start (or when the cloned
#  run dirs are missing on a restart). Bulky run output is excluded.
# ============================================================
if [ -n "${EXP_NAME}" ]; then
    [ "${SRC_WORK}" != "${WORK_DIR}" ] || die "EXP_NAME work tree == clone source; refusing"
    [ -d "${SRC_WORK}/forward_run" ] || die "clone source missing: ${SRC_WORK}/forward_run"
    [ -d "${SRC_WORK}/adjoint" ]     || die "clone source missing: ${SRC_WORK}/adjoint"
    if [ "${RESTART}" != "true" ] || [ ! -f "${FWD_DIR}/gchp" ] || [ ! -f "${ADJ_DIR}/gchp" ]; then
        log "EXP_NAME=${EXP_NAME}: cloning run dirs from ${SRC_WORK} → ${WORK_DIR}"
        mkdir -p "${FWD_DIR}" "${ADJ_DIR}"
        RSYNC_EXCL=(--exclude 'OutputDir/*' --exclude 'gcadj_*checkpoint*'
                    --exclude 'Restarts/gcchem_internal_checkpoint*'
                    --exclude cap_restart --exclude '*.o[0-9]*' --exclude '*.log'
                    --exclude allPEs.log --exclude 'logfile.*' --exclude EGRESS)
        rsync -a "${RSYNC_EXCL[@]}" "${SRC_WORK}/forward_run/" "${FWD_DIR}/"
        rsync -a "${RSYNC_EXCL[@]}" "${SRC_WORK}/adjoint/"     "${ADJ_DIR}/"
        log "EXP_NAME=${EXP_NAME}: run dirs cloned"
    else
        log "EXP_NAME=${EXP_NAME}: run dirs present, skipping clone (restart)"
    fi
fi

# ============================================================
#  Copy control files to run directories (must come before gchp.env source)
# ============================================================
[ -d "${CTRL_FWD_DIR}" ] || die "Forward control files not found: ${CTRL_FWD_DIR}"
[ -d "${CTRL_ADJ_DIR}" ] || die "Adjoint control files not found: ${CTRL_ADJ_DIR}"
mkdir -p "${FORCING_DIR}" "${OUTPUT_DIR}" "${ADJ_DIR}/Restarts" "${FWD_DIR}/Restarts"
[ "${MODE}" = "monthly" ] && mkdir -p "${SIGMA_DIR}"
rsync -a "${CTRL_FWD_DIR}/" "${FWD_DIR}/"
rsync -a "${CTRL_ADJ_DIR}/" "${ADJ_DIR}/"
log "Control files synced to run directories"

# Since the MAPL step_reverse fix (binary gchp.ref_20261014 and later) the adjoint must
# read met with the FORWARD time offsets; the old one-step-shifted adjoint ExtData.rc
# would put the adjoint met one step off without any error.
if [ -f "${SCRIPT_DIR}/set_adjoint_met_offsets.py" ]; then
    python3 "${SCRIPT_DIR}/set_adjoint_met_offsets.py" "${FWD_DIR}/ExtData.rc" "${ADJ_DIR}/ExtData.rc" --check \
        || die "adjoint ExtData.rc met offsets differ from the forward ones (fix: set_adjoint_met_offsets.py on ${CTRL_ADJ_DIR}/ExtData.rc)"
else
    log "WARNING: ${SCRIPT_DIR}/set_adjoint_met_offsets.py not found, adjoint met offsets not checked"
fi

# The adjoint flux must be the forward flux without sigma (factor 750): any other factor
# (e.g. the OSSE prior error E, factor 752) missing in the adjoint scales the gradient
# wrongly without any error message.
if [ -f "${SCRIPT_DIR}/check_adjoint_flux_config.py" ]; then
    python3 "${SCRIPT_DIR}/check_adjoint_flux_config.py" "${FWD_DIR}/HEMCO_Config.rc" "${ADJ_DIR}/HEMCO_Config.rc" \
        || die "adjoint HEMCO flux is not the forward flux without sigma (see above)"
else
    log "WARNING: ${SCRIPT_DIR}/check_adjoint_flux_config.py not found, adjoint flux config not checked"
fi
# OSSE prior error E (read as ../prior_err_co2.nc4 from the run dirs = the work tree)
if grep -q '^[^#]*prior_err_co2\.nc4' "${FWD_DIR}/HEMCO_Config.rc"; then
    [ -f "${WORK_DIR}/prior_err_co2.nc4" ] || die "HEMCO uses the prior error E but ${WORK_DIR}/prior_err_co2.nc4 is missing (make_prior_err.py)"
    log "prior error E: ${WORK_DIR}/prior_err_co2.nc4"
fi

# Patch the sat_track track_file into both HISTORY.rc and sat_track.rcx so they
# always agree, regardless of what the template control files contain.
for _stcfg in "${FWD_DIR}/HISTORY.rc" "${FWD_DIR}/sat_track.rcx"; do
    [ -f "${_stcfg}" ] && \
        sed -i "s|\(sat_track\.track_file:[[:space:]]*\).*|\1${SAT_TRACK_FILE}|" "${_stcfg}"
done
[ -f "${FWD_DIR}/${SAT_TRACK_FILE}" ] || [ -L "${FWD_DIR}/${SAT_TRACK_FILE}" ] || \
    die "sat_track track file not found in forward run dir: ${FWD_DIR}/${SAT_TRACK_FILE}"
log "sat_track track_file: ${SAT_TRACK_FILE}"

# ============================================================
#  Environment
# ============================================================
GCHP_ENV="${FWD_DIR}/gchp.env"
[ -f "${GCHP_ENV}" ] || die "${GCHP_ENV} not found"
set +e
source "${GCHP_ENV}"
set -e
command -v mpiexec &>/dev/null || die "mpiexec not found after sourcing ${GCHP_ENV}"

PYTHON_ENV="${PYTHON_ENV:-/nobackup/ksuselj1/envs/gchp_4dvar}"
[ -f "${PYTHON_ENV}/bin/activate" ] || die "Python env not found: ${PYTHON_ENV}"
source "${PYTHON_ENV}/bin/activate"
export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
python3 -c "import numpy, pandas, xarray, netCDF4" 2>/dev/null \
    || die "Python env is missing required packages (numpy pandas xarray netCDF4)"
echo "Python env: $(python3 --version)  from ${PYTHON_ENV}"

# Pre-import plotting libraries so their .so/.pyc files and matplotlib's font
# cache are warm in the OS page cache before the first plotting call.
# plt.figure()/plt.close() forces the font-cache build to happen here rather
# than inside the first iteration's plot run (avoids a ~40-min NFS cold-start).
python3 -c "
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.animation as animation
import xarray as xr
import shapefile as _shp
plt.figure(); plt.close()    # triggers font cache build
" 2>/dev/null \
    && log "plot libraries pre-warmed (matplotlib/xarray/shapefile)" \
    || log "WARNING: plot pre-warm failed (first-iteration plots may be slow)"

# Core count = NODES * 24, driven through runConfig's TOTAL_CORES. NXNY_AUTO=ON
# regenerates GCHP.rc NX/NY from TOTAL_CORES on every run (line ~509), so the
# durable knob is TOTAL_CORES in runConfig — patching GCHP.rc directly would be
# overwritten. Applied to both the forward and adjoint run dirs.
NCORES=$(( NODES * 24 ))
# runConfig enforces TOTAL_CORES == NUM_NODES * NUM_CORES_PER_NODE, so set both
# (NUM_CORES_PER_NODE stays 24, NUM_NODES = NODES).
for _rcfg in "${FWD_DIR}/runConfig_forward.sh" "${ADJ_DIR}/runConfig_adjoint.sh"; do
    [ -f "${_rcfg}" ] || die "runConfig not found: ${_rcfg}"
    sed -i -E "s/^TOTAL_CORES=.*/TOTAL_CORES=${NCORES}/; s/^NUM_NODES=.*/NUM_NODES=${NODES}/" "${_rcfg}"
    grep -qxE "TOTAL_CORES=${NCORES}" "${_rcfg}" || die "failed to set TOTAL_CORES=${NCORES} in ${_rcfg}"
    grep -qxE "NUM_NODES=${NODES}"    "${_rcfg}" || die "failed to set NUM_NODES=${NODES} in ${_rcfg}"
done
log "Core count: NODES=${NODES} -> ${NCORES} cores (runConfig TOTAL_CORES=${NCORES} NUM_NODES=${NODES}, NXNY_AUTO)"

[ -f "${FWD_DIR}/gchp" ] || die "Forward GCHP executable not found: ${FWD_DIR}/gchp"
[ -f "${ADJ_DIR}/gchp" ] || die "Adjoint GCHP executable not found: ${ADJ_DIR}/gchp"

# ============================================================
#  Grid + parallel-isolation patches to the run-dir control files
# ============================================================
# Cubed-sphere face size from the model grid (C{CS_RES}); used for --grid cs.
CS_RES=$(awk -F'[[:space:]:]+' '/^GCHP.IM_WORLD/{print $2}' "${FWD_DIR}/GCHP.rc")
[ -n "${CS_RES}" ] || CS_RES=24

# Isolate the adjoint forcing dir for THIS run. OCO2_FORCING_DIR is an absolute
# path in GCHP.rc; unpatched, two parallel runs would read the same forcing.
for _g in "${ADJ_DIR}/GCHP.rc" "${FWD_DIR}/GCHP.rc"; do
    [ -f "${_g}" ] && sed -i "s|^OCO2_FORCING_DIR:.*|OCO2_FORCING_DIR: ${FORCING_DIR}/|" "${_g}"
done
log "OCO2_FORCING_DIR set to ${FORCING_DIR}/"

if [ "${GRID}" = "cs" ]; then
    # Native cubed-sphere adjoint output: disable the lat-lon grid_label so
    # SurfaceFluxAdj_CO2 is written on the model C-grid and read back cell-for-cell
    # (removes the lat-lon<->CS interpolation mismatch in the gradient).
    sed -i 's/^\([[:space:]]*\)Adjoint.grid_label:/\1#Adjoint.grid_label:/'   "${ADJ_DIR}/HISTORY.rc"
    sed -i 's/^\([[:space:]]*\)Adjoint.conservative:/\1#Adjoint.conservative:/' "${ADJ_DIR}/HISTORY.rc"
    log "GRID=cs: native C${CS_RES}; adjoint grid_label disabled (native-CS gradient)"
else
    log "GRID=latlon: sigma ${NLAT}x${NLON}; adjoint output on lat-lon grid"
fi

# ============================================================
#  Patch runConfig timing from T_START / T_END
# ============================================================
START_FMT="$(echo "${T_START}" | tr -d '-') 000000"
END_FMT="$(echo "${T_END}"   | tr -d '-') 000000"
DURATION_DAYS=$(( ($(date -d "${T_END}" +%s) - $(date -d "${T_START}" +%s)) / 86400 ))
# CAP.rc JOB_SGMT (= runConfig Duration) is a YYYYMMDD calendar increment, NOT a
# raw day count.  The DD field is only 2 digits, so a plain %08d of the total
# days overflows into the MM field once the window reaches 100 days: e.g. 366 ->
# "00000366" is parsed as 0y 03m 66d ~ 157 days, so a 1-year run stopped on
# 2016-06-06.  Decompose into calendar Y/M/D instead.  OSSE windows are whole
# months (day = 01), so the day component is exact.
_sY=$(date -d "${T_START}" +%Y); _sM=$(date -d "${T_START}" +%m); _sD=$(date -d "${T_START}" +%d)
_eY=$(date -d "${T_END}"   +%Y); _eM=$(date -d "${T_END}"   +%m); _eD=$(date -d "${T_END}"   +%d)
_dD=$(( 10#${_eD} - 10#${_sD} ))
_dtotM=$(( (10#${_eY}*12 + 10#${_eM}) - (10#${_sY}*12 + 10#${_sM}) ))
if [ "${_dD}" -lt 0 ]; then _dtotM=$(( _dtotM - 1 )); _dD=$(( _dD + 30 )); fi
DURATION_FMT="$(printf '%04d%02d%02d' $(( _dtotM / 12 )) $(( _dtotM % 12 )) "${_dD}") 000000"

for _cfg in "${FWD_DIR}/runConfig_forward.sh" "${ADJ_DIR}/runConfig_adjoint.sh"; do
    sed -i "s/^Start_Time=.*/Start_Time=\"${START_FMT}\"/" "${_cfg}"
    sed -i "s/^End_Time=.*/End_Time=\"${END_FMT}\"/"       "${_cfg}"
    sed -i "s/^Duration=.*/Duration=\"${DURATION_FMT}\"/"  "${_cfg}"
done
sed -i 's/^INITIAL_RESTART=.*/INITIAL_RESTART=gcchem_initial_restart.nc4/' \
    "${ADJ_DIR}/runConfig_adjoint.sh"
log "runConfig patched: Start=\"${START_FMT}\"  End=\"${END_FMT}\"  Duration=\"${DURATION_FMT}\" (${DURATION_DAYS} days)"

# ============================================================
#  Restart / fresh-start handling  (phase-level resume)
# ============================================================
CUR_ITER=1
CUR_PHASE=start
if [ "${RESTART}" = "true" ]; then
    if [ -f "${PROGRESS_FILE}" ]; then
        CUR_ITER=$(sed -n 's/^iter=\([0-9]*\) .*/\1/p' "${PROGRESS_FILE}")
        CUR_PHASE=$(sed -n 's/.* phase=\(.*\)$/\1/p' "${PROGRESS_FILE}")
        [ -n "${CUR_ITER}" ] && [ -n "${CUR_PHASE}" ] \
            || die "Cannot parse ${PROGRESS_FILE}: $(cat "${PROGRESS_FILE}")"
        log "Resuming at iteration ${CUR_ITER}, after phase '${CUR_PHASE}'"
    elif [ -f "${STATE_FILE}" ]; then
        CUR_ITER=$(python3 -c \
            "import numpy as np; s=np.load('${STATE_FILE}'); print(int(s['iteration']))")
        log "RESTART=true, no progress file; state says iteration ${CUR_ITER} — starting it from phase 'start'"
    else
        log "WARNING: RESTART=true but no progress or state file — starting fresh"
    fi
else
    log "Fresh start: clearing state, progress, snapshots, forcing and converged marker"
    rm -f "${STATE_FILE}" "${PROGRESS_FILE}" "${CONVERGED_FILE}"
    rm -f "${OUTPUT_DIR}"/4dvar_state_iter*.npz \
          "${OUTPUT_DIR}"/forcing_iter*.nc4 \
          "${OUTPUT_DIR}"/daily_forcing_iter*.nc4 \
          "${OUTPUT_DIR}"/restart_after_iter*.sh \
          "${OUTPUT_DIR}"/restart_latest.sh
    rm -rf "${OUTPUT_DIR}"/adjoint_iter*
    find "${FORCING_DIR}" -maxdepth 1 -type f \
        \( -name 'CO2_adjoint_forcing_*.nc4' -o -name 'forcing_all_obs.nc4' \
           -o -name 'daily_forcing_stats.nc4' -o -name 'J_value.txt' \) \
        -delete 2>/dev/null || true
    # Annual: drop the single sigma file so iteration 1 regenerates sigma=1.
    # Monthly: write_sigma_monthly rewrites all NMON fields before the forward.
    [ "${MODE}" = "annual" ] && rm -f "${SIGMA_FILE}"
fi
save_progress

# ============================================================
#  Plot helper (a plot failure must never abort the optimization)
# ============================================================
make_plots() {
    log "Generating plots → ${PLOT_DIR}"
    # GRID=cs plots need native lats/lons from a C-grid GCHP file; adjoint output
    # carries them.  Empty string is harmless: plot_4dvar.py then auto-probes
    # --output-dir.  (No effect for GRID=latlon.)
    local coord_file
    # NB: keep this tolerant of missing globs — under `set -euo pipefail` a
    # non-zero `ls` (e.g. no forward SpeciesConc files on an adjoint-only
    # resume) would otherwise abort the whole script here.  Empty is harmless.
    # -S sorts by size (largest first); tail -1 picks the smallest file.
    # The final-step adjoint file (~1 MB) carries lats/lons just as well as the
    # full-record file (~4 GB), so prefer small to avoid slow NFS open.
    coord_file=$(ls -1S "${ADJ_DIR}/OutputDir"/GEOSChem.Adjoint.*.nc4 \
                        "${FWD_DIR}/OutputDir"/GEOSChem.SpeciesConc.*.nc4 \
                        2>/dev/null | tail -1 || true)
    python3 "${SCRIPT_DIR}/plot_4dvar.py" \
        --state-file  "${STATE_FILE}" \
        --output-dir  "${OUTPUT_DIR}" \
        --forcing-dir "${FORCING_DIR}" \
        --log-file    "${LOG_FILE}" \
        --plot-dir    "${PLOT_DIR}" \
        --coord-file  "${coord_file}" \
        --sigma-min   "${SIGMA_MIN}" \
        --sigma-max   "${SIGMA_MAX}" \
        && log "Plots saved to ${PLOT_DIR}" \
        || log "WARNING: plot_4dvar.py failed (plots not generated)"
}

# Archive monthly-mean EmisCO2_Total from a completed forward run (one .nc4 per iteration).
# Soft failure: a failed archive never aborts the optimization.
archive_emissions() {
    local iter_label out fwd_outdir rc=0
    iter_label=$(printf '%03d' "${CUR_ITER}")
    out="${OUTPUT_DIR}/emissions_monthly_iter${iter_label}.nc4"
    fwd_outdir="${FWD_DIR}/OutputDir"
    python3 - "${fwd_outdir}" "${out}" <<'PYEOF' || rc=$?
import sys, glob, xarray as xr
src_dir, out_path = sys.argv[1], sys.argv[2]
files = sorted(glob.glob(f"{src_dir}/GEOSChem.Emissions.*.nc4"))
if not files:
    raise SystemExit(f"No Emissions files in {src_dir} — skipping")
ds0 = xr.open_dataset(files[0])
# Skip topology variables (contacts, anchor, corner_*) that have no time dim
time_vars = [v for v in ds0.data_vars if 'time' in ds0[v].dims]
ds = xr.concat([xr.open_dataset(f)[time_vars] for f in files], dim='time')
monthly = ds.resample(time='MS').mean()
monthly.to_netcdf(out_path)
print(f"  {len(monthly.time)} monthly mean(s), {len(files)} daily files -> {out_path}")
PYEOF
    [ "${rc}" -eq 0 ] \
        && log "[iter ${CUR_ITER}] Monthly-mean EmisCO2_Total archived -> ${out}" \
        || log "WARNING: monthly-mean emissions archive failed rc=${rc} (non-fatal)"
}

# Plot truth vs optimized EmisCO2_Total maps and global-mean bar chart.
# Soft failure: a missing truth file or coord issue never aborts the optimization.
plot_emissions_comparison() {
    local iter_label opt_file truth_file coord_file rc=0
    iter_label=$(printf '%03d' "${CUR_ITER}")
    opt_file="${OUTPUT_DIR}/emissions_monthly_iter${iter_label}.nc4"
    truth_file="${_OSSE4DVAR_DIR}/obs/truth_emissions_monthly_2016Q1.nc"

    # Find a coord file that carries CS lats/lons: prefer archived adjoint output
    # from previous iterations (guaranteed to have lats/lons); fall through to
    # the current forward OutputDir (Emissions files may also carry them).
    coord_file=$(ls -1S "${OUTPUT_DIR}"/adjoint_iter*/GEOSChem.Adjoint.*.nc4 \
                        "${ADJ_DIR}/OutputDir"/GEOSChem.Adjoint.*.nc4 \
                        2>/dev/null | tail -1 || true)

    python3 "${SCRIPT_DIR}/plot_emissions.py" \
        --truth      "${truth_file}" \
        --opt        "${opt_file}" \
        --plot-dir   "${PLOT_DIR}" \
        --iter-label "${iter_label}" \
        --cs-res     "${CS_RES}" \
        ${coord_file:+--coord-file "${coord_file}"} \
        --search-dir "${FWD_DIR}/OutputDir" \
        --search-dir "${OUTPUT_DIR}" \
        || rc=$?
    [ "${rc}" -eq 0 ] \
        && log "[iter ${CUR_ITER}] Emissions comparison plots saved -> ${PLOT_DIR}" \
        || log "WARNING: emissions comparison plots failed rc=${rc} (non-fatal)"
}

# Plot TER flux comparison: truth / prior / optimized averaged over the window.
# Soft failure: never aborts the optimization.
plot_ter_comparison() {
    local iter_label out rc=0
    iter_label=$(printf '%03d' "${CUR_ITER}")
    out="${PLOT_DIR}/ter_comparison_iter${iter_label}.png"

    python3 "${SCRIPT_DIR}/plot_ter_comparison.py" \
        --truth      "${_OSSE4DVAR_DIR}/obs/truth_emissions_monthly_2016Q1.nc" \
        --state      "${STATE_FILE}" \
        --out        "${out}" \
        --t-start    "${T_START}" \
        --t-end      "${T_END}" \
        --iter-label "${iter_label}" \
        || rc=$?
    [ "${rc}" -eq 0 ] \
        && log "[iter ${CUR_ITER}] TER comparison plot saved -> ${out}" \
        || log "WARNING: TER comparison plot failed rc=${rc} (non-fatal)"
}

# ============================================================
#  Outer loop  (phase machine; each phase marks itself done)
# ============================================================
log "========================================================"
log " 4D-Var OSSE (MODE=${MODE}) — chain job ${CHAIN_N}"
log " window ${T_START} -> ${T_END}  (${NMON} months)  nlat=${NLAT} nlon=${NLON} sigma_b=${SIGMA_B}"
log " starting at iteration ${CUR_ITER}, after phase '${CUR_PHASE}'  (max_iter=${MAX_ITER})"
log " log → ${LOG_FILE}"
log "========================================================"

# ------------------------------------------------------------
#  Submission record — one block per (re)submission, appended to a durable
#  log in the work tree so how a run was actually launched is always
#  recoverable.  A fresh (non-restart) launch starts a clean record; restarts
#  and self-chained resubmissions append, keeping the full launch history.
#  The block logs the DERIVED window (months + days), not just the raw -v
#  args, so a mismatch between EXP_NAME and the real T_END (e.g. a "3months"
#  experiment accidentally launched full-year) is obvious at a glance.
# ------------------------------------------------------------
# single-string -v list (no embedded spaces) so the reproduce line is copy-pasteable
_repro_v="MODE=${MODE},GRID=${GRID},OBS_TYPE=${OBS_TYPE},T_START=${T_START},T_END=${T_END},MAX_ITER=${MAX_ITER},EXP_NAME=${EXP_NAME},SIGMA_B=${SIGMA_B}"
_submit_log="${WORK_DIR}/submit.log"
# Fresh launch (RESTART!=true) resets the record — consistent with the fresh
# start above that clears state/progress; a brand-new EXP begins a clean log.
[ "${RESTART}" = "true" ] || : > "${_submit_log}"
{
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] job=${PBS_JOBID:-interactive} chain=${CHAIN_N} restart=${RESTART} resume(iter=${CUR_ITER},phase=${CUR_PHASE})"
    echo "    mode=${MODE} grid=${GRID} exp=${EXP_NAME:-<none>} sigma_b=${SIGMA_B} max_iter=${MAX_ITER}"
    echo "    window ${T_START} -> ${T_END}  (${NMON} months, ${DURATION_DAYS} days)"
    echo "    reproduce: qsub -v ${_repro_v} $(basename "${SELF:-$0}")"
} >> "${_submit_log}" || log "WARNING: could not write submission record to ${_submit_log}"

while [ "${CUR_ITER}" -le "${MAX_ITER}" ]; do

    # ----------------------------------------------------------
    # Phase 1: sigma + forward GCHP + move checkpoints
    # ----------------------------------------------------------
    if [ "${CUR_PHASE}" = "start" ]; then
        budget_ok "${EST_FORWARD_S}" || resubmit

        if [ "${MODE}" = "monthly" ]; then
            log "[iter ${CUR_ITER}] Writing ${NMON} monthly sigma files (+1 boundary)"
            python3 "${SCRIPT_DIR}/write_sigma_monthly.py" \
                --sigma-dir  "${SIGMA_DIR}" \
                --state-file "${STATE_FILE}" \
                --nlat "${NLAT}" --nlon "${NLON}" \
                --year "${T_START:0:4}" \
                --n-months "${NMON}" --start-month "${START_MONTH}" \
                || die "write_sigma_monthly.py failed"
        else
            log "[iter ${CUR_ITER}] Writing sigma_co2_osse.nc4 (grid=${GRID})"
            python3 "${SCRIPT_DIR}/write_sigma.py" \
                --sigma-file "${SIGMA_FILE}" \
                --state-file "${STATE_FILE}" \
                --grid "${GRID}" \
                --nlat "${NLAT}" --nlon "${NLON}" --cs-res "${CS_RES}" \
                --t-start "${T_START}" \
                || die "write_sigma.py failed"
        fi

        log "[iter ${CUR_ITER}] Forward GCHP — started (${DURATION_DAYS} days)"
        cd "${FWD_DIR}"
        rm -f gcadj_internal_checkpoint* gcadj_import_checkpoint*
        [ -d OutputDir ] && find OutputDir -maxdepth 1 -type f -delete
        rm -f Restarts/gcchem_internal_checkpoint* cap_restart

        ./runConfig_forward.sh > gchp.log 2>&1 \
            || die "runConfig_forward.sh failed (iter ${CUR_ITER})"
        mpiexec -n "${NCORES}" ./gchp >> gchp.log 2>&1 \
            || die "Forward GCHP failed (iter ${CUR_ITER}). See ${FWD_DIR}/gchp.log"
        assert_gchp_ok "${FWD_DIR}/gchp.log" "Forward GCHP (iter ${CUR_ITER})"
        log "[iter ${CUR_ITER}] Forward GCHP — done"

        archive_emissions
        plot_emissions_comparison

        # Move gcadj checkpoints forward -> adjoint (mv = rename, no copy).
        # find -exec avoids ARG_MAX on tens of thousands of checkpoint files.
        log "[iter ${CUR_ITER}] Moving checkpoints forward → adjoint"
        _nckpt=$(find . -maxdepth 1 \( -name 'gcadj_internal_checkpoint*' \
                 -o -name 'gcadj_import_checkpoint*' \) | wc -l)
        find . -maxdepth 1 \( -name 'gcadj_internal_checkpoint*' \
             -o -name 'gcadj_import_checkpoint*' \) -exec mv -t "${ADJ_DIR}/" {} +
        log "  Moved ${_nckpt} adjoint checkpoint file(s) → ${ADJ_DIR}/"

        _ckpt=$(ls Restarts/gcchem_internal_checkpoint* 2>/dev/null | head -1)
        [ -z "${_ckpt}" ] && die "No gcchem_internal_checkpoint in ${FWD_DIR}/Restarts"
        mv "${_ckpt}" "${ADJ_DIR}/gcchem_initial_restart.nc4"
        log "  Moved $(basename "${_ckpt}") → gcchem_initial_restart.nc4"

        cd "${BASE_DIR}"
        CUR_PHASE=forward_done
        save_progress
    fi

    # ----------------------------------------------------------
    # Phase 2: J_obs + adjoint forcing (all sat_track files in the window)
    # ----------------------------------------------------------
    if [ "${CUR_PHASE}" = "forward_done" ]; then
        log "[iter ${CUR_ITER}] Computing J_obs and adjoint forcing"

        find "${FORCING_DIR}" -maxdepth 1 -type f \
            \( -name 'CO2_adjoint_forcing_*.nc4' -o -name 'forcing_all_obs.nc4' \
               -o -name 'daily_forcing_stats.nc4' -o -name 'J_value.txt' \) \
            -delete 2>/dev/null || true

        # OutputDir was wiped before the forward run, so every sat_track file
        # there belongs to THIS iteration. Pass them all; co2_adjoint_forcing_osse.py
        # verifies exactly one file per month of the window and dies loudly on
        # stale/missing/duplicate months (one file for a 1-month annual window).
        mapfile -t SAT_FILES < \
            <(ls "${FWD_DIR}/OutputDir"/GEOSChem.sat_track.*.nc4 2>/dev/null || true)
        [ "${#SAT_FILES[@]}" -eq 0 ] && \
            die "No sat_track files in ${FWD_DIR}/OutputDir (iter ${CUR_ITER})"
        log "  sat_track files found: ${#SAT_FILES[@]}"

        _diag_flag=""
        [ "${SAVE_DIAG}" = "true" ] || _diag_flag="--no-save-diagnostics"

        # Build observation-mode flags
        _obs_flags=""
        if [ "${OBS_MODE}" = "simplified" ]; then
            _obs_flags="--simplified-ak-file ${SIMPLIFIED_AK_FILE} --semi-obs-file ${SEMI_OBS_FILE}"
            log "  OBS_MODE=simplified: using fixed mean AK from $(basename "${SIMPLIFIED_AK_FILE}")"
        elif [ -n "${SEMI_OBS_FILE}" ]; then
            _obs_flags="--semi-obs-file ${SEMI_OBS_FILE}"
            log "  OBS_MODE=real (semi-obs-file): $(basename "${SEMI_OBS_FILE}")"
        else
            log "  OBS_MODE=real (ORCHIDEE-ECCO2 L2# per-obs AK)"
        fi

        python3 "${SCRIPT_DIR}/co2_adjoint_forcing_osse.py" \
            "${SAT_FILES[@]}" "${FORCING_DIR}" \
            --ts-chem "${TS_DYN}" \
            --t-start "${T_START}T00:00:00" \
            --t-end   "${T_END}T00:00:00" \
            ${_obs_flags} \
            ${_diag_flag} \
            || die "co2_adjoint_forcing_osse.py failed (iter ${CUR_ITER})"

        _diag_src="${FORCING_DIR}/forcing_all_obs.nc4"
        [ -f "${_diag_src}" ] && cp "${_diag_src}" \
            "${OUTPUT_DIR}/forcing_iter$(printf '%03d' "${CUR_ITER}").nc4"
        _daily_src="${FORCING_DIR}/daily_forcing_stats.nc4"
        [ -f "${_daily_src}" ] && cp "${_daily_src}" \
            "${OUTPUT_DIR}/daily_forcing_iter$(printf '%03d' "${CUR_ITER}").nc4"

        CUR_PHASE=forcing_done
        save_progress
    fi

    # ----------------------------------------------------------
    # Phase 3: adjoint GCHP
    # ----------------------------------------------------------
    if [ "${CUR_PHASE}" = "forcing_done" ]; then
        budget_ok "${EST_ADJOINT_S}" || resubmit

        log "[iter ${CUR_ITER}] Adjoint GCHP — started"
        cd "${ADJ_DIR}"
        [ -d OutputDir ] && rm -f OutputDir/GEOSChem*
        rm -f Restarts/gcchem_internal_checkpoint* cap_restart

        ./runConfig_adjoint.sh > gchp.log 2>&1 \
            || die "runConfig_adjoint.sh failed (iter ${CUR_ITER})"
        mpiexec -n "${NCORES}" ./gchp >> gchp.log 2>&1 \
            || die "Adjoint GCHP failed (iter ${CUR_ITER}). See ${ADJ_DIR}/gchp.log"
        assert_gchp_ok "${ADJ_DIR}/gchp.log" "Adjoint GCHP (iter ${CUR_ITER})"
        log "[iter ${CUR_ITER}] Adjoint GCHP — done"

        # Free the consumed gcadj checkpoints (only after adjoint success, since a
        # redo of THIS phase needs them). find -delete avoids the ARG_MAX limit.
        _nrm=$(find . -maxdepth 1 \( -name 'gcadj_internal_checkpoint*' \
               -o -name 'gcadj_import_checkpoint*' \) | wc -l)
        find . -maxdepth 1 \( -name 'gcadj_internal_checkpoint*' \
             -o -name 'gcadj_import_checkpoint*' \) -delete
        log "  Deleted ${_nrm} consumed gcadj checkpoint file(s)"

        cd "${BASE_DIR}"
        CUR_PHASE=adjoint_done
        save_progress
    fi

    # ----------------------------------------------------------
    # Phase 4: L-BFGS-B step
    # ----------------------------------------------------------
    if [ "${CUR_PHASE}" = "adjoint_done" ]; then
        log "[iter ${CUR_ITER}] L-BFGS-B optimizer step (MODE=${MODE})"
        cd "${BASE_DIR}"

        rc=0
        if [ "${MODE}" = "monthly" ]; then
            python3 "${SCRIPT_DIR}/lbfgsb_step_monthly.py" \
                --state-file  "${STATE_FILE}" \
                --forcing-dir "${FORCING_DIR}" \
                --adj-output  "${ADJ_DIR}/OutputDir" \
                --nlat "${NLAT}" --nlon "${NLON}" \
                --n-months "${NMON}" \
                --sigma-b "${SIGMA_B}" \
                --sigma-min "${SIGMA_MIN}" --sigma-max "${SIGMA_MAX}" \
                --t-start "${T_START}" --t-end "${T_END}" \
                --gtol "${GTOL}" --ftol "${FTOL}" \
                || rc=$?
        else
            python3 "${SCRIPT_DIR}/lbfgsb_step.py" \
                --state-file  "${STATE_FILE}" \
                --forcing-dir "${FORCING_DIR}" \
                --adj-output  "${ADJ_DIR}/OutputDir" \
                --grid "${GRID}" \
                --nlat "${NLAT}" --nlon "${NLON}" --cs-res "${CS_RES}" \
                --sigma-b "${SIGMA_B}" \
                --sigma-min "${SIGMA_MIN}" --sigma-max "${SIGMA_MAX}" \
                --t-start "${T_START}" \
                --gtol "${GTOL}" --ftol "${FTOL}" \
                || rc=$?
        fi

        [ -f "${STATE_FILE}" ] && cp "${STATE_FILE}" \
            "${OUTPUT_DIR}/4dvar_state_iter$(printf '%03d' "${CUR_ITER}").npz"

        # Record the step as done BEFORE the (slow, optional) archiving and plots:
        # the state file has already advanced, so a job killed after this point must
        # resume at the next iteration. Re-running the optimizer step on a resume
        # would pair the old J and gradient with the new sigma.
        if [ "${rc}" -eq 0 ]; then
            CUR_PHASE=step_done
            save_progress
        fi

        # Archive the per-iteration adjoint gradient output (monthly only — the
        # monthly gradient is reconstructed by differencing these files).
        if [ "${MODE}" = "monthly" ]; then
            _adj_iter_dir="${OUTPUT_DIR}/adjoint_iter$(printf '%03d' "${CUR_ITER}")"
            mkdir -p "${_adj_iter_dir}"
            _nadj=$(find "${ADJ_DIR}/OutputDir" -maxdepth 1 \
                         -name 'GEOSChem.Adjoint.*.nc4' | wc -l)
            if [ "${_nadj}" -gt 0 ]; then
                cp "${ADJ_DIR}/OutputDir"/GEOSChem.Adjoint.*.nc4 "${_adj_iter_dir}/"
                log "  Adjoint output archived (${_nadj} files) → ${_adj_iter_dir}/"
            else
                log "  WARNING: no GEOSChem.Adjoint.*.nc4 in ${ADJ_DIR}/OutputDir"
            fi
        fi

        # Save a ready-to-run restart command (resume from iteration CUR_ITER+1).
        _restart_cmd="${OUTPUT_DIR}/restart_after_iter$(printf '%03d' "${CUR_ITER}").sh"
        {
            echo "#!/bin/bash"
            echo "# Resume 4D-Var OSSE (MODE=${MODE}) from iteration $((CUR_ITER + 1)) (iter ${CUR_ITER} done)"
            echo "# Generated: $(date '+%Y-%m-%d %H:%M:%S')"
            echo "cd \"${BASE_DIR}\""
            echo "qsub -v \"RESTART=true,${VPASS}\" ${SELF}"
        } > "${_restart_cmd}"
        chmod +x "${_restart_cmd}"
        cp "${_restart_cmd}" "${OUTPUT_DIR}/restart_latest.sh"
        log "  Restart command saved → ${_restart_cmd}"

        make_plots
        # After the optimizer step so the state file exists (iter 1) and
        # x_best includes this iteration's evaluation.
        plot_ter_comparison

        if [ "${rc}" -eq 1 ]; then
            log "========================================================"
            log " CONVERGED at iteration ${CUR_ITER}"
            log "========================================================"
            touch "${CONVERGED_FILE}"
            exit 0
        elif [ "${rc}" -ne 0 ]; then
            die "L-BFGS-B step returned error code ${rc}"
        fi
        log "[iter ${CUR_ITER}] Iteration complete — state saved"
    fi

    # Optimizer step done (also the resume point after it): next iteration
    if [ "${CUR_PHASE}" = "step_done" ]; then
        CUR_ITER=$((CUR_ITER + 1))
        CUR_PHASE=start
        save_progress
    fi
done

log ""
log "========================================================"
log " 4D-Var OSSE (MODE=${MODE}) finished (MAX_ITER=${MAX_ITER} reached)"
log " Final state:             ${STATE_FILE}"
log " Per-iteration snapshots: ${OUTPUT_DIR}/"
log " Log:                     ${LOG_FILE}"
log "========================================================"
make_plots
